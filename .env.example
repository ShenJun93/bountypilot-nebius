# Copy to .env (never commit .env). Every key is optional; without one the app falls back
# to the rule engine and GitHub-only liveness checks.
NEBIUS_API_KEY=
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
TAVILY_API_KEY=
# GITHUB_TOKEN=  (raises the GitHub API rate limit for liveness checks)
# UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=  (durable queue when hosted)
